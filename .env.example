# ReconAI Environment Configuration

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
RECON_DATA_DIR=./data
RECON_MODELS_DIR=./models

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production Domain (if deploying behind Nginx or custom domain)
# Set NEXT_PUBLIC_API_URL="" if frontend and backend share the same domain via Nginx reverse proxy
# CORS_ORIGINS=https://recon.yourdomain.com
