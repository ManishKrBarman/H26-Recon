[Unit]
Description=ReconAI Next.js Frontend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/reconai/frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=127.0.0.1"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
